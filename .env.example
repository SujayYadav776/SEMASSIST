# Copy to .env.local (git-ignored) and fill in.
#
# None of this is needed to run or test the dashboard locally — the browser app
# only needs the publishable key already committed in client/public/supabase-config.js.
# These variables exist for owner-side project setup scripts.

# --- Supabase Management API (used by scripts/configure-auth-smtp.mjs) -------
# Personal access token: https://supabase.com/dashboard/account/tokens
# This is a privileged token. Keep it in .env.local only, never in a commit.
SUPABASE_ACCESS_TOKEN=
# The ref from your project URL, https://<ref>.supabase.co
SUPABASE_PROJECT_REF=nrxbelpmydquivcphxry

# --- Transactional email for Supabase Auth ----------------------------------
# Without custom SMTP, Supabase only sends auth mail to project-team addresses
# (2 messages/hour), so real sign-ups fail with
# "Error sending confirmation email". See continue.md.
#
# Resend preset: verify a domain at https://resend.com/domains, then create a
# key at https://resend.com/api-keys and run:
#   npm run smtp:configure -- --provider resend --apply
RESEND_API_KEY=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=SEM ASSIST

# Any other provider: uncomment and use --provider generic.
# Ports: 465 = implicit SSL/TLS, 587 = STARTTLS.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
